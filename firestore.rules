rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function assignmentPath() {
      return /databases/$(database)/documents/user_roles/$(request.auth.uid);
    }

    function hasAssignment() {
      return signedIn() && exists(assignmentPath());
    }

    function assignment() {
      return get(assignmentPath()).data;
    }

    function activeAssignment() {
      return hasAssignment() && assignment().isActive == true;
    }

    function rolePath() {
      return /databases/$(database)/documents/app_roles/$(assignment().roleId);
    }

    function hasActiveRole() {
      return activeAssignment()
          && exists(rolePath())
          && get(rolePath()).data.isActive == true;
    }

    function permissions() {
      return hasActiveRole()
          ? get(rolePath()).data.permissions
          : [];
    }

    function hasPermission(permission) {
      return hasActiveRole() && permission in permissions();
    }

    function hasAnyPermission(a, b) {
      return hasPermission(a) || hasPermission(b);
    }

    function isSuperAdmin() {
      return hasActiveRole()
          && (
            assignment().roleId == 'super_admin'
            || hasPermission('rolesManage')
          );
    }

    function isInternalChatUser() {
      return hasActiveRole()
          && (
            assignment().roleId == 'teacher'
            || assignment().roleId == 'admin'
            || assignment().roleId == 'super_admin'
            || hasPermission('rolesManage')
          );
    }

    function isInternalChatUid(uid) {
      return exists(/databases/$(database)/documents/user_roles/$(uid))
          && get(/databases/$(database)/documents/user_roles/$(uid)).data.isActive == true
          && (
            get(/databases/$(database)/documents/user_roles/$(uid)).data.roleId == 'teacher'
            || get(/databases/$(database)/documents/user_roles/$(uid)).data.roleId == 'admin'
            || get(/databases/$(database)/documents/user_roles/$(uid)).data.roleId == 'super_admin'
          );
    }

    function ownsParentAccount(parentId) {
      return signedIn()
          && exists(
            /databases/$(database)/documents/parent_accounts/$(parentId)
          )
          && (
            request.auth.uid ==
              get(/databases/$(database)/documents/parent_accounts/$(parentId)).data.authUserId
            || request.auth.uid ==
              get(/databases/$(database)/documents/parent_accounts/$(parentId)).data.userId
          );
    }

    function ownsTeacherProfile(teacherId) {
      return signedIn()
          && exists(/databases/$(database)/documents/teachers/$(teacherId))
          && request.auth.token.email != null
          && request.auth.token.email ==
              get(/databases/$(database)/documents/teachers/$(teacherId)).data.email;
    }

    function isLinkedParentStudent(studentId) {
      return activeAssignment()
          && assignment().roleId == 'parent'
          && studentId in assignment().studentIds;
    }

    function resourceStudentId() {
      return resource.data.studentId;
    }

    function requestStudentId() {
      return request.resource.data.studentId;
    }

    function isPublishedResultStatus(status) {
      return status == 'published' || status == 'locked';
    }

    function validResultWorkflowTransition(before, after) {
      return before == after
          || (before == 'draft' && after == 'generated')
          || (before == 'generated'
              && (after == 'verified' || after == 'draft'))
          || (before == 'verified'
              && (after == 'approved' || after == 'generated'))
          || (before == 'approved'
              && (after == 'published' || after == 'verified'))
          || (before == 'published'
              && (after == 'locked'
                  || after == 'approved'
                  || after == 'unpublished'))
          || (before == 'locked' && after == 'published')
          || (before == 'unpublished'
              && (after == 'approved' || after == 'published'));
    }

    function resultWorkflowFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
        'schemaVersion',
        'generatedAt',
        'generatedBy',
        'verifiedAt',
        'verifiedBy',
        'approvedAt',
        'approvedBy',
        'publishedAt',
        'publishedBy',
        'lockedAt',
        'lockedBy',
        'unlockedAt',
        'unlockedBy',
        'unlockReason'
      ]);
    }

    function resultWorkflowActorMatches() {
      return (request.resource.data.status == 'generated'
              && request.resource.data.generatedBy == request.auth.uid)
          || (request.resource.data.status == 'verified'
              && request.resource.data.verifiedBy == request.auth.uid)
          || (request.resource.data.status == 'approved'
              && request.resource.data.approvedBy == request.auth.uid)
          || (request.resource.data.status == 'published'
              && (
                (resource.data.status == 'locked'
                  && request.resource.data.unlockedBy == request.auth.uid
                  && request.resource.data.unlockReason is string
                  && request.resource.data.unlockReason.size() > 0)
                || (resource.data.status != 'locked'
                  && request.resource.data.publishedBy == request.auth.uid)
              ))
          || (request.resource.data.status == 'locked'
              && request.resource.data.lockedBy == request.auth.uid)
          || request.resource.data.status == 'unpublished'
          || request.resource.data.status == 'draft';
    }

    // -----------------------------------------------------------------
    // RBAC administration
    // -----------------------------------------------------------------

    match /app_roles/{roleId} {
      allow read: if signedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /user_roles/{userId} {
      allow read: if signedIn()
          && (
            request.auth.uid == userId
            || isSuperAdmin()
            || (isInternalChatUser() && isInternalChatUid(userId))
          );

      allow create, update, delete: if isSuperAdmin();

      // Canonical identity requirement.
      allow create, update: if isSuperAdmin()
          && request.resource.data.userId == userId;
    }

    // -----------------------------------------------------------------
    // Core academic directories
    // -----------------------------------------------------------------

    match /students/{studentId} {
      allow read: if hasPermission('studentsView')
          || isLinkedParentStudent(studentId);
      allow create: if hasPermission('studentsCreate');
      allow update: if hasPermission('studentsEdit');
      allow delete: if hasPermission('studentsDelete');
    }

    match /teachers/{document=**} {
      allow read: if hasPermission('teachersView');
      allow create: if hasPermission('teachersCreate');
      allow update: if hasPermission('teachersEdit');
      allow delete: if hasPermission('teachersDelete');
    }

    match /staff/{document=**} {
      allow read: if hasPermission('staffView');
      allow create: if hasPermission('staffCreate');
      allow update: if hasPermission('staffEdit');
      allow delete: if hasPermission('staffDelete');
    }

    match /classes/{document=**} {
      allow read: if hasPermission('classesView');
      allow write: if hasPermission('classesManage');
    }

    match /sections/{document=**} {
      allow read: if hasPermission('classesView');
      allow write: if hasPermission('classesManage');
    }

    match /subjects/{document=**} {
      allow read: if hasAnyPermission('classesView', 'timetableView');
      allow write: if hasPermission('classesManage');
    }

    match /academic_subjects/{document=**} {
      allow read: if hasPermission('classesView')
          || hasPermission('timetableView')
          || hasPermission('examsView')
          || hasPermission('resultsView');
      allow write: if hasPermission('classesManage');
    }

    match /subject_components/{document=**} {
      allow read: if hasPermission('classesView')
          || hasPermission('examsView')
          || hasPermission('resultsView');
      allow write: if hasPermission('classesManage');
    }

    // -----------------------------------------------------------------
    // Attendance
    // -----------------------------------------------------------------

    match /attendance/{document=**} {
      allow read: if hasPermission('attendanceView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create: if hasPermission('attendanceMark');
      allow update, delete: if hasPermission('attendanceEdit');
    }

    match /teacher_attendance/{document=**} {
      allow read: if hasAnyPermission('teachersView', 'attendanceView');
      allow write: if hasPermission('attendanceEdit');
    }

    match /staff_attendance/{document=**} {
      allow read: if hasAnyPermission('staffView', 'attendanceView');
      allow write: if hasPermission('attendanceEdit');
    }

    // -----------------------------------------------------------------
    // Fees
    // -----------------------------------------------------------------

    match /fee_structures/{document=**} {
      allow read: if hasPermission('feesView');
      allow write: if hasPermission('feesManage');
    }

    match /student_fee_assignments/{document=**} {
      allow read: if hasPermission('feesView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow write: if hasPermission('feesManage');
    }

    match /monthly_fees/{document=**} {
      allow read: if hasPermission('feesView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create, update: if hasAnyPermission('feesManage', 'feesCollect');
      allow delete: if hasPermission('feesManage');
    }

    match /student_fees/{document=**} {
      allow read: if hasPermission('feesView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create, update: if hasAnyPermission('feesManage', 'feesCollect');
      allow delete: if hasPermission('feesManage');
    }

    match /fee_payments/{document=**} {
      allow read: if hasPermission('feesView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create, update: if hasPermission('feesCollect');
      allow delete: if hasPermission('feesManage');
    }

    match /additional_charges/{document=**} {
      allow read: if hasPermission('feesView');
      allow create, update: if hasPermission('feesManage');
      allow delete: if hasPermission('feesManage');
    }

    match /student_additional_charge_dues/{document=**} {
      allow read: if hasPermission('feesView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create: if hasPermission('feesManage');
      allow update: if hasAnyPermission('feesManage', 'feesCollect');
      allow delete: if hasPermission('feesManage');
    }

    match /fee_challans/{document=**} {
      allow read: if hasPermission('feesView');
      allow write: if hasAnyPermission('feesManage', 'feesCollect');
    }

    match /fee_receipts/{document=**} {
      allow read: if hasPermission('feesView');
      allow write: if hasAnyPermission('feesManage', 'feesCollect');
    }

    // -----------------------------------------------------------------
    // Accounts and payroll
    // -----------------------------------------------------------------

    match /expense_categories/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /expenses/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /income_entries/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /payroll_profiles/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /payroll_records/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /salary_history/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow create: if hasPermission('reportsExport');
      allow update, delete: if false;
    }

    match /payroll_migrations/{document=**} {
      allow read, create: if hasPermission('reportsExport');
      allow update, delete: if false;
    }

    match /monthly_profit_loss/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    match /cashbook_entries/{document=**} {
      allow read: if hasAnyPermission('reportsView', 'reportsExport');
      allow write: if hasPermission('reportsExport');
    }

    // -----------------------------------------------------------------
    // Exams, date sheets and results
    // -----------------------------------------------------------------

    match /exams/{document=**} {
      allow read: if hasPermission('examsView');
      allow write: if hasPermission('examsManage');
    }

    match /exam_subject_setups/{document=**} {
      allow read: if hasPermission('examsView');
      allow write: if hasPermission('examsManage');
    }

    match /exam_marks/{document=**} {
      allow read: if hasAnyPermission('examsView', 'resultsView');
      allow create, update: if hasPermission('resultsEnter');
      allow delete: if hasPermission('examsManage');
    }

    match /exam_date_sheets/{document=**} {
      allow read: if hasPermission('dateSheetsView');
      allow write: if hasPermission('dateSheetsManage');
    }

    match /exam_questions/{document=**} {
      allow read: if hasPermission('examsView');
      allow write: if hasPermission('examsManage');
    }

    match /exam_question_papers/{document=**} {
      allow read: if hasPermission('examsView');
      allow write: if hasPermission('examsManage');
    }

    match /exam_question_progress/{document=**} {
      allow read: if hasPermission('examsView');
      allow write: if hasPermission('examsManage');
    }

    match /exam_results/{resultId} {
      allow read: if hasPermission('resultsView')
          || (
            isLinkedParentStudent(resource.data.studentId)
            && isPublishedResultStatus(resource.data.status)
          );

      allow create: if hasAnyPermission('resultsEnter', 'resultsPublish')
          && request.resource.data.status in ['draft', 'generated']
          && (
            request.resource.data.status != 'generated'
            || request.resource.data.generatedBy == request.auth.uid
          );

      allow update: if (
            hasAnyPermission('resultsEnter', 'resultsPublish')
            && resource.data.status in ['draft', 'generated', 'verified', 'unpublished']
            && request.resource.data.status == 'generated'
            && request.resource.data.generatedBy == request.auth.uid
          )
          || (
            hasPermission('resultsPublish')
            && resultWorkflowFieldsOnly()
            && validResultWorkflowTransition(
              resource.data.status,
              request.resource.data.status
            )
            && resultWorkflowActorMatches()
          );

      allow delete: if hasPermission('resultsPublish');
    }

    match /annual_promotion_runs/{runId} {
      allow read, create, update: if hasPermission('resultsPublish')
          && hasPermission('studentsEdit');
      allow delete: if false;
    }

    match /annual_promotion_history/{historyId} {
      allow read, create: if hasPermission('resultsPublish')
          && hasPermission('studentsEdit');
      allow update, delete: if false;
    }

    match /results/{document=**} {
      allow read: if hasPermission('resultsView')
          || (
            isLinkedParentStudent(resourceStudentId())
            && isPublishedResultStatus(resource.data.status)
          );
      allow create: if hasPermission('resultsEnter')
          && request.resource.data.status in ['draft', 'generated'];
      allow update: if (
            hasPermission('resultsEnter')
            && resource.data.status in ['draft', 'generated', 'verified', 'unpublished']
            && request.resource.data.status == resource.data.status
          )
          || (
            hasPermission('resultsPublish')
            && resultWorkflowFieldsOnly()
            && validResultWorkflowTransition(
              resource.data.status,
              request.resource.data.status
            )
            && resultWorkflowActorMatches()
          );
      allow delete: if hasPermission('resultsPublish');
    }

    match /result_sheets/{document=**} {
      allow read: if hasPermission('resultsView')
          || (
            isLinkedParentStudent(resourceStudentId())
            && isPublishedResultStatus(resource.data.status)
          );
      allow create: if hasPermission('resultsEnter')
          && request.resource.data.status in ['draft', 'generated'];
      allow update: if (
            hasPermission('resultsEnter')
            && resource.data.status in ['draft', 'generated', 'verified', 'unpublished']
            && request.resource.data.status == resource.data.status
          )
          || (
            hasPermission('resultsPublish')
            && resultWorkflowFieldsOnly()
            && validResultWorkflowTransition(
              resource.data.status,
              request.resource.data.status
            )
            && resultWorkflowActorMatches()
          );
      allow delete: if hasPermission('resultsPublish');
    }

    // -----------------------------------------------------------------
    // Timetable and homework
    // -----------------------------------------------------------------

    match /timetable_entries/{document=**} {
      allow read: if hasPermission('timetableView');
      allow write: if hasPermission('timetableManage');
    }

    match /timetable_configurations/{document=**} {
      allow read: if hasPermission('timetableView');
      allow write: if hasPermission('timetableManage');
    }

    match /teacher_availability/{document=**} {
      allow read: if hasPermission('timetableView');
      allow write: if hasPermission('timetableManage');
    }

    match /homework/{document=**} {
      allow read: if hasPermission('homeworkView')
          || (activeAssignment()
              && assignment().roleId == 'parent'
              && resource.data.status == 'published');
      allow create: if hasPermission('homeworkCreate')
          && (
            assignment().roleId != 'teacher'
            || ownsTeacherProfile(request.resource.data.teacherId)
          );
      allow update: if hasPermission('homeworkCreate')
          && (
            assignment().roleId != 'teacher'
            || (
              ownsTeacherProfile(resource.data.teacherId)
              && request.resource.data.teacherId == resource.data.teacherId
            )
          );
      allow delete: if hasPermission('homeworkReview');
    }

    match /syllabus_entries/{document=**} {
      allow read: if hasPermission('homeworkView')
          || (
            signedIn()
            && resource.data.planId is string
            && get(/databases/$(database)/documents/syllabus_plans/$(resource.data.planId)).data.isPublished == true
          );
      allow create: if hasPermission('homeworkCreate')
          && (
            assignment().roleId != 'teacher'
            || ownsTeacherProfile(request.resource.data.teacherId)
          );
      allow update: if hasPermission('homeworkCreate')
          && (
            assignment().roleId != 'teacher'
            || (
              ownsTeacherProfile(resource.data.teacherId)
              && request.resource.data.teacherId == resource.data.teacherId
            )
          );
      allow delete: if hasPermission('homeworkReview');
    }

    match /syllabus_plans/{document=**} {
      allow read: if hasPermission('homeworkView')
          || (signedIn() && resource.data.isPublished == true);
      allow create, update: if hasPermission('homeworkCreate');
      allow delete: if hasPermission('homeworkReview');
    }

    match /homework_questions/{questionId} {
      allow read: if hasPermission('parentsManage')
          || ownsParentAccount(resource.data.parentId)
          || ownsTeacherProfile(resource.data.teacherId);
      allow create: if ownsParentAccount(request.resource.data.parentId)
          && request.resource.data.studentId in
              get(/databases/$(database)/documents/parent_accounts/$(request.resource.data.parentId)).data.studentIds;
      allow update: if hasPermission('parentsManage')
          || ownsParentAccount(resource.data.parentId)
          || ownsTeacherProfile(resource.data.teacherId);
      allow delete: if hasPermission('parentsManage');
    }

    match /homework_submissions/{document=**} {
      allow read: if hasPermission('homeworkView')
          || (
            activeAssignment()
            && assignment().roleId == 'parent'
            && resourceStudentId() in assignment().studentIds
          );
      allow create: if signedIn()
          && (
            request.auth.uid == request.resource.data.submittedByUserId
            || hasPermission('homeworkCreate')
          );
      allow update: if hasPermission('homeworkReview')
          || (
            signedIn()
            && request.auth.uid == resource.data.submittedByUserId
          );
      allow delete: if hasPermission('homeworkReview');
    }

    // -----------------------------------------------------------------
    // Notices and calendar
    // -----------------------------------------------------------------

    match /notices/{document=**} {
      allow read: if hasPermission('noticesView');
      allow write: if hasPermission('noticesManage');
    }

    match /notice_receipts/{receiptId} {
      allow read: if hasPermission('noticesManage')
          || (
            signedIn()
            && resource.data.recipientId == request.auth.uid
          );
      allow create, update: if signedIn()
          && request.resource.data.recipientId == request.auth.uid;
      allow delete: if hasPermission('noticesManage');
    }

    match /academic_calendar_events/{document=**} {
      allow read: if hasPermission('calendarView');
      allow write: if hasPermission('calendarManage');
    }

    // -----------------------------------------------------------------
    // Parent portal
    // -----------------------------------------------------------------

    match /parent_accounts/{parentId} {
      allow read: if hasPermission('parentsView')
          || ownsParentAccount(parentId);
      allow create, update, delete: if hasPermission('parentsManage');
    }

    match /parent_notifications/{notificationId} {
      allow read: if hasPermission('parentsManage')
          || (
            signedIn()
            && resource.data.parentAuthUserId == request.auth.uid
          );
      allow create: if hasPermission('parentsManage');
      allow update, delete: if hasPermission('parentsManage')
          || (
            signedIn()
            && resource.data.parentAuthUserId == request.auth.uid
          );
    }

    match /portal_notifications/{notificationId} {
      allow read, update, delete: if hasPermission('parentsManage')
          || (
            resource.data.recipientType == 'parent'
            && ownsParentAccount(resource.data.recipientId)
          )
          || (
            resource.data.recipientType == 'teacher'
            && ownsTeacherProfile(resource.data.recipientId)
          );
      allow create: if signedIn();
    }

    match /push_device_tokens/{tokenId} {
      allow read, delete: if signedIn()
          && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
    }

    match /communication_threads/{threadId} {
      allow read, update, delete: if isInternalChatUser()
          && request.auth.uid in resource.data.participantIds;
      allow create: if isInternalChatUser()
          && request.resource.data.participantIds.size() == 2
          && request.auth.uid in request.resource.data.participantIds
          && isInternalChatUid(request.resource.data.participantIds[0])
          && isInternalChatUid(request.resource.data.participantIds[1]);
    }

    match /chat_messages/{messageId} {
      allow read: if isInternalChatUser()
          && request.auth.uid in
              get(/databases/$(database)/documents/communication_threads/$(resource.data.threadId)).data.participantIds;
      allow create: if isInternalChatUser()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
              get(/databases/$(database)/documents/communication_threads/$(request.resource.data.threadId)).data.participantIds;
      allow update: if isInternalChatUser()
          && request.auth.uid in
              get(/databases/$(database)/documents/communication_threads/$(resource.data.threadId)).data.participantIds;
      allow delete: if false;
    }

    match /parent_leave_requests/{requestId} {
      allow read: if hasPermission('parentsManage')
          || ownsParentAccount(resource.data.parentId);
      allow create: if ownsParentAccount(request.resource.data.parentId)
          && request.resource.data.studentId in
              get(/databases/$(database)/documents/parent_accounts/$(request.resource.data.parentId)).data.studentIds;
      allow update: if hasPermission('parentsManage');
      allow delete: if hasPermission('parentsManage');
    }

    // -----------------------------------------------------------------
    // Configuration, reporting and audit
    // -----------------------------------------------------------------

    match /academic_year_config/{document=**} {
      allow read: if signedIn();
      allow write: if hasPermission('settingsManage');
    }

    match /academic_year_configs/{document=**} {
      allow read: if signedIn();
      allow write: if hasPermission('settingsManage');
    }

    match /audit_logs/{document=**} {
      allow read: if hasPermission('auditLogsView');
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Known supporting collections not yet mapped to a dedicated
    // permission use authenticated access during this staged release.
    match /{document=**} {
      allow read, write: if signedIn()
          && (
            isSuperAdmin()
            || hasPermission('settingsManage')
          );
    }
  }
}
