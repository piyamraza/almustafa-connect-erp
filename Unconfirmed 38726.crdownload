$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$root = (Get-Location).Path
if (-not (Test-Path (Join-Path $root 'pubspec.yaml'))) {
    throw 'Run this script from the almustafa-connect-erp project root.'
}

$utf8 = New-Object System.Text.UTF8Encoding($false)
$sidebarFile = 'lib/features/dashboard/presentation/widgets/sidebar.dart'

function Read-ProjectFile {
    param([Parameter(Mandatory = $true)][string]$RelativePath)

    $path = Join-Path $root $RelativePath

    if (-not (Test-Path $path)) {
        throw "Required file not found: $RelativePath"
    }

    return [IO.File]::ReadAllText($path).Replace("`r`n", "`n")
}

function Write-ProjectFile {
    param(
        [Parameter(Mandatory = $true)][string]$RelativePath,
        [Parameter(Mandatory = $true)][string]$Content
    )

    $path = Join-Path $root $RelativePath
    [IO.File]::WriteAllText($path, $Content, $utf8)
    Write-Host "Updated: $RelativePath" -ForegroundColor Green
}

$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$backupRoot = Join-Path (Split-Path $root -Parent) "almustafa-connect-erp_backups/sidebar_visible_scrollbar_$stamp"
$backupFile = Join-Path $backupRoot $sidebarFile

New-Item -ItemType Directory -Path (Split-Path $backupFile -Parent) -Force | Out-Null
Copy-Item (Join-Path $root $sidebarFile) $backupFile -Force

$content = Read-ProjectFile -RelativePath $sidebarFile

if (-not $content.Contains('final ScrollController _scrollController')) {
    $content = $content.Replace(
        'class _SidebarState extends State<Sidebar> {' + "`n" +
        '  late final AccessControlService _access;',
        'class _SidebarState extends State<Sidebar> {' + "`n" +
        '  late final AccessControlService _access;' + "`n" +
        '  final ScrollController _scrollController = ScrollController();'
    )
}

if (-not $content.Contains('_scrollController.dispose();')) {
    $content = $content.Replace(
        '  void dispose() {' + "`n" +
        '    _access.removeListener(_refresh);' + "`n" +
        '    super.dispose();' + "`n" +
        '  }',
        '  void dispose() {' + "`n" +
        '    _access.removeListener(_refresh);' + "`n" +
        '    _scrollController.dispose();' + "`n" +
        '    super.dispose();' + "`n" +
        '  }'
    )
}

if (-not $content.Contains('thumbVisibility: true')) {
    $oldListViewStart = @'
          : ListView(
              padding: const EdgeInsets.symmetric(vertical: 16),
              children: [
'@

    $newListViewStart = @'
          : Scrollbar(
              controller: _scrollController,
              thumbVisibility: true,
              trackVisibility: true,
              interactive: true,
              thickness: 8,
              radius: const Radius.circular(8),
              child: ListView(
                controller: _scrollController,
                primary: false,
                padding: const EdgeInsets.fromLTRB(0, 16, 12, 16),
                children: [
'@

    if (-not $content.Contains($oldListViewStart)) {
        throw 'Sidebar ListView anchor not found.'
    }

    $content = $content.Replace($oldListViewStart, $newListViewStart)

    $oldListViewEnd = @'
              ],
            ),
    );
'@

    $newListViewEnd = @'
                ],
              ),
            ),
    );
'@

    if (-not $content.Contains($oldListViewEnd)) {
        throw 'Sidebar ListView closing anchor not found.'
    }

    $content = $content.Replace($oldListViewEnd, $newListViewEnd)
}

Write-ProjectFile -RelativePath $sidebarFile -Content $content

Write-Host ''
Write-Host 'Running dart format...' -ForegroundColor Cyan

& dart format $sidebarFile

if ($LASTEXITCODE -ne 0) {
    throw 'dart format failed.'
}

Write-Host ''
Write-Host 'Running flutter analyze...' -ForegroundColor Cyan

& flutter analyze

if ($LASTEXITCODE -ne 0) {
    throw 'flutter analyze found issues. Copy the complete output into ChatGPT.'
}

Write-Host ''
Write-Host 'Always-visible sidebar scrollbar added successfully.' -ForegroundColor Green
Write-Host 'The scrollbar can now be dragged without a mouse wheel.' -ForegroundColor Cyan
Write-Host "Backup: $backupRoot" -ForegroundColor DarkGray
